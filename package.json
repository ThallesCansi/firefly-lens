{
  "name": "firefly-lens",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/generate-historical-radar.mjs --check && node scripts/copy-maplibre-worker.mjs && next dev",
    "build": "node scripts/generate-historical-radar.mjs --check && node scripts/copy-maplibre-worker.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "radar:generate": "node scripts/generate-historical-radar.mjs",
    "radar:check": "node scripts/generate-historical-radar.mjs --check",
    "radar:qa": "node scripts/qa-historical-radar.mjs"
  },
  "dependencies": {
    "d3-array": "^3.2.5",
    "d3-scale": "^4.0.3",
    "katex": "^0.19.1",
    "maplibre-gl": "^6.18.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/katex": "^0.16.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.34.9",
  "license": "MIT",
  "description": "One fire calendar from MODIS and VIIRS hot spots. NASA Space Apps Challenge 2026."
}
